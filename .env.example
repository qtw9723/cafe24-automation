# Cafe24 일일 자동화 환경 설정 — 복사해서 .env 로 사용: cp .env.example .env
# run_daily.sh 가 source 하고, 수동 실행 시에는 config.py 가 python-dotenv 로 읽는다.

# 모니터링 대상 백오피스 주소 (사내망)
CAFE24_URL=http://localhost:3001

# 알림 메일 발신 계정 (Gmail SMTP 587 STARTTLS, 앱 비밀번호 사용)
GMAIL_USER=your.account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 수신자 (콤마로 여러 명). 비우면 GMAIL_USER 로 보낸다.
RECIPIENT_EMAIL=you@example.com

# (선택) 해지 감지 프로브 경로 — cafe24-monitoring 저장소의 tools/cancel_probe
# CANCEL_PROBE_DIR=$HOME/IdeaProjects/cafe24-monitoring/cafe24_backoffice/tools/cancel_probe
